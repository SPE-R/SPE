.Rprofile
.Rproj.user
.Rhistory
.RData
.Ruserdata
build/
build-lectures/
*.Rproj
.DS_Store

# Bookdown rendered output and intermediates
pracs-book/_book/
pracs-book/_bookdown_files/
pracs-book/SPE-R-*-practicals*/
pracs-book/SPE-R-*-practicals*.rds
# knitr per-chapter figure / asset directories (e.g. basic-s_files/, ggplot2-e_files/)
pracs-book/*_files/

# Auto-generated solution chapter files
# (regenerated from -e.rmd by misc/from_e_to_s_rmd.R on every build)
pracs-book/*-s.rmd

# Auto-generated R-package bibliography (rewritten by knitr::write_bib on every render)
pracs-book/packages.bib

# RStudio markdown preview artifacts under misc/
misc/*.html
misc/*_files/

# Local backups of refreshed lockfiles
renv.lock.*.bak
