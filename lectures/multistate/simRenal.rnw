% %----------------------------------------------------------------------
% \begin{frame}{A more complicated multistate model}
% \vspace*{-1em}
% \includegraphics[width=0.82\textwidth]{./GbAd-states.pdf}
% \end{frame}

% %----------------------------------------------------------------------
% \begin{frame}{A more complicated multistate model}
% \includegraphics[width=0.75\textwidth]{./GbAd-probs.pdf}
% \end{frame}
