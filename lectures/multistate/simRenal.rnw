%----------------------------------------------------------------------
\begin{frame}
   \frametitle{How many persons should you simulate?}
\pause
   \begin{itemize}[<+->]
   \item All probabilities have the same denominator --- the initial
     number of persons in the simulation, $N$, say.
   \item Thus, any probability will be of the form $p=x/N$
   \item For small probabilities we have that:
\[
 \se\bigl(\log(\hat p)\bigr) = (1-p)/\sqrt{N p (1-p)}
\]
\item So c.i. has the form $p\td \erf$ where:
\[
 \erf = \exp\bigl( 1.96 \times (1-p)/\sqrt{N p (1-p)} \bigr)
\]
\item 42,000
   \end{itemize}
\end{frame}

%----------------------------------------------------------------------
\begin{frame}
   \frametitle{Precision of simulated probabilities}
\includegraphics[width=0.75\textwidth]{./se-probs.pdf}
\end{frame}

%----------------------------------------------------------------------
\begin{frame}[fragile,allowframebreaks]{Using a simulated
    \code{Lexis} object --- sojourn time}
<<>>=
summary(sim1)
xtabs(lex.dur / 10000 ~ lex.Cst, data = sim1) |> addmargins()
@
During the first 15 years after entry, the expected time in remission
is 1.5 years out of an expected lifetime of 8.8 years, for a 40 year old man
\end{frame}

%----------------------------------------------------------------------
\begin{frame}
   \frametitle{Multistate model overview}
\pause
   \begin{itemize}[<+->]
   \item Clarifies the relevant states and transitions
   \item Allows proper estimation of transition rates
   \item --- and relationships between them
   \item Separate model for each transition
   \item The usual survival methodology to compute probabilities breaks down
   \item Using transition rates for simulation allows estimation of:

     \begin{itemize}[<+->]
     \item transition rates (as usual)
     \item cumulative probabilities (\textbf{not} quite as usual)
     \item sojourn times (how long in each state)
     \end{itemize}

   \end{itemize}
\end{frame}

\end{document}
